# Copy this file to .env.local for local development, and add the same four values in
# Vercel -> Settings -> Environment Variables for production.

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth's own session encryption key - NOT the same as the Google credentials above.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The site's own public URL. Locally this is http://localhost:3000. In production, set it to
# your real Vercel URL, e.g. https://program-builder-omega.vercel.app
NEXTAUTH_URL=
